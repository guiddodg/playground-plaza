# Unity YAML merge driver
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.mat merge=unityyamlmerge eol=lf
*.anim merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial merge=unityyamlmerge eol=lf
*.physicsMaterial2D merge=unityyamlmerge eol=lf
*.playable merge=unityyamlmerge eol=lf
*.meta merge=unityyamlmerge eol=lf
*.guiskin merge=unityyamlmerge eol=lf

# Images — binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.tiff binary
*.psd binary
*.exr binary
*.hdr binary
*.ico binary

# 3D models — binary
*.fbx binary
*.obj text eol=lf
*.dae binary
*.3ds binary

# Audio — binary
*.mp3 binary
*.wav binary
*.ogg binary

# Video — binary
*.mp4 binary
*.mov binary

# Fonts — binary
*.ttf binary
*.otf binary

# Archives — binary
*.zip binary
*.unitypackage binary

# Text files
*.cs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.inputactions text eol=lf
